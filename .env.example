# ─── Application ───────────────────────────────
APP_ENV=development
APP_NAME=sajura-be
LOG_LEVEL=INFO

# ─── Database (MySQL) ──────────────────────────
DB_HOST=mysql
DB_PORT=3306
DB_NAME=sajura
DB_USER=app_user
DB_PASSWORD=change_me

# Local Docker MySQL bootstrap (docker/mysql/init.sh)
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=sajura
MYSQL_USER=app_user
MYSQL_PASSWORD=change_me

# ─── Redis (cache + ARQ broker + rate limit) ──
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ─── OAuth (spec/07_backend/service_design.md §1, security.md) ──
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ─── JWT ───────────────────────────────────────
JWT_SECRET=change_me_jwt_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS=2592000

# ─── AES-256-GCM (pos_connections.api_key, security.md §4.1) ──
AES_GCM_KEY_BASE64=

# ─── VAPID (Web Push, schema.md §3.23, pywebpush) ──
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com

# ─── Sentry (sentry-sdk[fastapi]) ──────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_RELEASE=

# ─── External services ─────────────────────────
AI_SERVER_BASE_URL=http://ai-server:8001
N8N_BASE_URL=http://n8n:5678

# ─── CORS / TrustedHost (service_design.md §10.2-10.3) ──
CORS_ALLOW_ORIGINS=http://localhost:5173
TRUSTED_HOSTS=localhost,be
